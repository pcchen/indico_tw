msgid "Upcoming events"
msgstr "即將發生的活動"

#: indico/modules/categories/__init__.py
msgid "Event creation"
msgstr "活動創建"

#: indico/modules/categories/__init__.py
msgid "Allows creating events in the category"
msgstr "允許在類別中創建活動"

#: indico/modules/categories/__init__.py
msgid "Request event move"
msgstr "請求活動移動"

#: indico/modules/categories/__init__.py
msgid "Allows requesting for an event to be moved to this category"
msgstr "允許請求將活動移至此類別"

#: indico/modules/categories/forms.py indico/modules/events/forms.py
#: indico/modules/events/management/forms.py
#: indico/modules/events/management/templates/_settings.html
#: indico/modules/events/templates/emails/event_creation.txt
#: indico/modules/users/forms.py
msgid "Timezone"
msgstr "時區"

#: indico/modules/categories/forms.py
msgid ""
"Default timezone event lists will show up in. It will also be used as a "
"default for new events."
msgstr "將顯示默認時區活動列表。它還將用作新活動的默認值。"

#: indico/modules/categories/forms.py
msgid "Theme for Lectures"
msgstr "講座主題"

#: indico/modules/categories/forms.py
msgid "Default timetable theme used for lecture events"
msgstr "用於講座的默認日程表主題"

#: indico/modules/categories/forms.py
msgid "Theme for Meetings"
msgstr "會議主題"

#: indico/modules/categories/forms.py
msgid "Default timetable theme used for meeting events"
msgstr "用於會議的默認日程表主題"

#: indico/modules/categories/forms.py
msgid "Disable Suggestions"
msgstr "禁用建議"

#: indico/modules/categories/forms.py
msgid ""
"Enable this if you don't want Indico to suggest this category as a possible "
"addition to a user's favorites."
msgstr "如果您不希望 Indico 建議將此類別作為用戶收藏夾的可能添加項，請啟用它。"

#: indico/modules/categories/forms.py
msgid "Allow flat view"
msgstr "允許平面視圖"

#: indico/modules/categories/forms.py
msgid ""
"Allow users to view all the events descending from this category in one "
"single page. This is not recommended on large categories with thousands of "
"events."
msgstr "允許用戶在一個頁面中查看從該類別降序的所有活動。 對於具有數千個活動的大型類別，不建議這樣做。"

#: indico/modules/categories/forms.py
msgid "Future months threshold"
msgstr "未來月份閾值"

#: indico/modules/categories/forms.py
msgid ""
"Events past the threshold will be hidden by default to avoid clutter, the "
"user can click to expand them. If no events are found within this threshold,"
" it is extended to show the first month with events."
msgstr "超過閾值的活動將預設隱藏以避免雜亂，使用者可點擊展開。若在此閾值內找不到活動，將延伸以顯示第一個有活動的月份。"

#: indico/modules/categories/forms.py
msgid "Message Type"
msgstr "消息類型"

#: indico/modules/categories/forms.py
msgid ""
"This message will show up at the top of every event page in this category"
msgstr "此消息將顯示在類別的所有活動的頂部"

#: indico/modules/categories/forms.py
msgid "Notify managers"
msgstr "通知管理員"

#: indico/modules/categories/forms.py
msgid ""
"Whether to send email notifications to all managers of this category when an"
" event is created inside it or in any of its subcategories."
msgstr "當在該類別或其任何子類別中創建活動時，是否向該類別的所有管理員發送電子郵件通知。"

#: indico/modules/categories/forms.py
msgid "Notification E-mails"
msgstr "通知郵件"

#: indico/modules/categories/forms.py
msgid ""
"List of emails that will receive a notification every time a new event is "
"created inside the category or one of its subcategories. One email address "
"per line."
msgstr "每當在類別或其子類別之中創建新活動時，都會收到通知的電子郵件列表。 每行一個電子郵件地址。"

#: indico/modules/categories/forms.py
msgid "Configuration"
msgstr "設定"

#: indico/modules/categories/forms.py
msgid ""
"The Google Wallet configuration is, by default, inherited from the parent "
"category. You can also explicitly disable it or provide your own "
"configuration instead."
msgstr "Google 錢包設定預設繼承自上層類別，您也可以明確停用它或提供您自己的設定。"

#: indico/modules/categories/forms.py
msgid "Google Credentials"
msgstr "Google 憑證"

#: indico/modules/categories/forms.py
msgid "JSON key credentials for the Google Service Account"
msgstr "Google 服務帳號的 JSON 金鑰憑證"

#: indico/modules/categories/forms.py
msgid "Issuer Name"
msgstr "發行者名稱"

#: indico/modules/categories/forms.py
msgid ""
"Issuer name that will appear in the Google Wallet ticket top header. Google "
"recommends a maximum length of 20 chars to ensure readability on all "
"devices."
msgstr "將顯示在 Google 錢包票券頂部標題中的發行者名稱，Google 建議最長 20 個字元以確保在所有裝置上的可讀性。"

#: indico/modules/categories/forms.py
msgid "Issuer ID"
msgstr "發行者 ID"

#: indico/modules/categories/forms.py
msgid ""
"Issuer ID assigned in the \"Google Pay & Wallet\" console. The same Issuer "
"ID must never be used on more than one Indico server. Changing it will also "
"break updates to any existing tickets."
msgstr "在「Google Pay & Wallet」控制臺中指派的發行者 ID，同一個發行者 ID 絕對不能用於多個 Indico 伺服器，更改它也會破壞現有票券的更新。"

#: indico/modules/categories/forms.py
msgid ""
"The Apple Wallet configuration is, by default, inherited from the parent "
"category. You can also explicitly disable it or provide your own "
"configuration instead."
msgstr "Apple 錢包設定預設繼承自上層類別，您也可以明確停用它或提供您自己的設定。"

#: indico/modules/categories/forms.py
msgid "Your certificate in PEM format"
msgstr "您的 PEM 格式憑證"

#: indico/modules/categories/forms.py
msgid "Private Key"
msgstr "私鑰"

#: indico/modules/categories/forms.py
msgid "Your private key in PEM format"
msgstr "您的 PEM 格式私鑰"

#: indico/modules/categories/forms.py
msgid "Passphrase"
msgstr "密碼短語"

#: indico/modules/categories/forms.py
msgid ""
"The passphrase used to decrypt the private key. Leave this empty if the "
"private key is not encrypted."
msgstr "用於解密私鑰的密碼短語。若私鑰未加密，請留空。"

#: indico/modules/categories/forms.py
msgid "The credentials could not be loaded."
msgstr "無法載入憑證。"

#: indico/modules/categories/forms.py
msgid ""
"The credentials are invalid or have no access to the Google Wallet API."
msgstr "憑證無效或無法存取 Google Wallet API。"

#: indico/modules/categories/forms.py
msgid ""
"There was an error validating your credentials. Contact your Indico "
"administrator for details."
msgstr "驗證您的憑證時發生錯誤，請聯繫您的 Indico 管理員以了解詳情。"

#: indico/modules/categories/forms.py
msgid "The Issuer ID is invalid or not linked to your credentials."
msgstr "發行者 ID 無效或未連結至您的憑證。"

#: indico/modules/categories/forms.py
msgid "The provided certificate is malformed."
msgstr "提供的憑證格式錯誤。"

#: indico/modules/categories/forms.py
msgid "The private key is malformed."
msgstr "私鑰格式錯誤。"

#: indico/modules/categories/forms.py
msgid "The private key is invalid."
msgstr "私鑰無效。"

#: indico/modules/categories/forms.py
msgid "The provided key is not encrypted, do not specify a password."
msgstr "提供的金鑰未加密，請勿指定密碼。"

#: indico/modules/categories/forms.py
msgid ""
"The provided key is encrypted, you must specify the password to decrypt it."
msgstr "提供的金鑰已加密，您必須指定密碼以解密。"

#: indico/modules/categories/forms.py
msgid "The provided password is incorrect."
msgstr "提供的密碼不正確。"

#: indico/modules/categories/forms.py
msgid ""
"Small icon that will show up next to category names in overview pages. Will "
"be automatically resized to 16x16 pixels. This may involve loss of image "
"quality, so try to upload images as close as possible to those dimensions."
msgstr "小圖標，將顯示在概述頁面的類別名稱旁邊。將自動調整為16x16像素。這可能會導致圖像質量下降，因此請嘗試上傳儘可能接近這些尺寸的圖像。"

#: indico/modules/categories/forms.py
msgid ""
"Logo that will show up next to the category description. Will be "
"automatically resized to at most 200x200 pixels."
msgstr "顯示在類別說明旁邊的徽標。將自動調整大小為最多200x200像素。"

#: indico/modules/categories/forms.py
#: indico/modules/events/contributions/forms.py indico/modules/events/forms.py
#: indico/modules/events/layout/forms.py
#: indico/modules/events/management/forms.py
#: indico/modules/events/sessions/forms.py
msgid "Protection mode"
msgstr "保護模式"

#: indico/modules/categories/forms.py
#: indico/modules/events/management/forms.py
msgid "No access contact"
msgstr "無法訪問時聯繫人"

#: indico/modules/categories/forms.py
msgid "Contact information shown when someone lacks access to the category"
msgstr "當某人無法訪問該類別時顯示的聯繫人信息"

#: indico/modules/categories/forms.py
msgid "Event visibility"
msgstr "活動可見度"

#: indico/modules/categories/forms.py
msgid ""
"From which point in the category tree contents will be visible from (number "
"of categories upwards). Applies to \"Today's events\" and Calendar. If the "
"category is moved, this number will be preserved."
msgstr "從類別樹的該點開始，內容將從（向上的類別數）中可見。適用於「今天的活動」和日曆。如果類別被移動，此號碼將被保留。"

#: indico/modules/categories/forms.py
msgid "Event creation mode"
msgstr "活動創建模式"

#: indico/modules/categories/forms.py
msgid ""
"Specify who can create events in the category and whether they need to be "
"approved. Regardless of this setting, users cannot create/propose events "
"unless they have at least read access to the category."
msgstr "指定誰可以在該類別中創建活動以及是否需要批准。 無論此設置如何，用戶都無法創建/提議活動，除非他們至少具有對該類別的讀取權限。"

#: indico/modules/categories/forms.py
#, python-brace-format
msgid "This category's visibility is currently limited by that of '{}'."
msgstr "此類別的可見性當前受 『{}』 的可見性限制。"

#: indico/modules/categories/forms.py indico/modules/events/util.py
#, python-brace-format
msgid "IP networks cannot have management permissions: {}"
msgstr "IP 網絡不能有管理權限：{}"

#: indico/modules/categories/forms.py
msgid "Category name #1"
msgstr "類別名 #1"

#: indico/modules/categories/forms.py
msgid "Selected events will be moved into a new sub-category with this title."
msgstr "選中的活動將被移到具有此名稱的新子類別下。"

#: indico/modules/categories/forms.py
msgid "Category name #2"
msgstr "類別名 #2"

#: indico/modules/categories/forms.py
msgid ""
"Events that were not selected will be moved into a new sub-category with "
"this title. If omitted, those events will remain in the current category."
msgstr "未選中的活動將移動到具有此名稱的新子類別中。如果省略，這些活動將保留在當前類別中。"

#: indico/modules/categories/forms.py
msgid "Category name"
msgstr "類別名"

#: indico/modules/categories/forms.py
msgid "The events will be moved into a new sub-category with this title."
msgstr "這個活動將被移到具有這個名字的子類別下。"

#: indico/modules/categories/forms.py
msgid "Max. events"
msgstr "最多活動"

#: indico/modules/categories/forms.py
msgid ""
"The maximum number of upcoming events to show. Events are sorted by weight "
"so events with a lower weight are more likely to be omitted if there are too"
" many events to show."
msgstr "要顯示的即將發生的活動的最大數目。活動按權重排序，因此如果要顯示的活動太多，則更可能忽略權重較低的活動。"

#: indico/modules/categories/forms.py indico/web/forms/fields/datetime.py
msgid "Days"
msgstr "天"

#: indico/modules/categories/forms.py
msgid "Weight"
msgstr "權重"

#: indico/modules/categories/forms.py
msgid "Category & Subcategories"
msgstr "類別 & 子類別"

#: indico/modules/categories/forms.py
msgid ""
"Specify categories/events shown in the 'upcoming events' list on the home "
"page."
msgstr "指定首頁上 '即將發生的活動' 列表中顯示的類別/活動。"

#: indico/modules/categories/forms.py
msgid "'Days' must be a positive integer"
msgstr "『天數』 必須是正整數"

#: indico/modules/categories/forms.py
msgid "Invalid type"
msgstr "無效類型"

#: indico/modules/categories/forms.py
#, python-brace-format
msgid "Invalid category: {}"
msgstr "無效類別: {}"

#: indico/modules/categories/forms.py
#, python-brace-format
msgid "Invalid event: {}"
msgstr "無效活動：{}"

#: indico/modules/categories/forms.py indico/modules/events/roles/forms.py
msgid "The full name of the role"
msgstr "角色全名"

#: indico/modules/categories/forms.py indico/modules/events/roles/forms.py
msgid "A shortcut (max. 3 characters) for the role"
msgstr "角色的縮寫（最多3個字符）"

#: indico/modules/categories/forms.py indico/modules/events/roles/forms.py
msgid "The color used when displaying the role"
msgstr "顯示角色時使用的顏色"

#: indico/modules/categories/forms.py indico/modules/events/roles/forms.py
msgid "A role with this code already exists."
msgstr "具有此代碼的角色已存在。"

#: indico/modules/categories/util.py
#, python-brace-format
msgid "From the category above"
msgid_plural "From {} categories above"
msgstr[0] "从 {} 类别往上"

#: indico/modules/categories/util.py
msgid "From this category only"
msgstr "僅此類別"

#: indico/modules/categories/util.py
msgid "From the current category only"
msgstr "僅來自當前類別"

